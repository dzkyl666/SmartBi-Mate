# ============================================================
# SmartBI Mate 环境变量模板
# 使用方法：复制为 .env 并填入真实值（.env 已在 .gitignore 中）
# ============================================================

# 百炼 DashScope API Key（必填）
# 获取地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your_api_key_here

# 本地 MySQL 完整连接串（必填，覆盖 config.yaml 里的脱敏占位符）
# 格式：mysql+pymysql://用户名:密码@127.0.0.1:3306/insightbi_demo?charset=utf8mb4
MYSQL_URI=mysql+pymysql://你的用户名:你的密码@127.0.0.1:3306/insightbi_demo?charset=utf8mb4
